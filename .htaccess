# VShark Solutions — production server rules (Apache / LiteSpeed). See DEPLOY.md.
# Netlify (the preview site) ignores this file and uses netlify.toml instead.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. One canonical address: https://www.vsharksolutions.com
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.vsharksolutions.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^vsharksolutions\.com$ [NC]
  RewriteRule ^ https://www.vsharksolutions.com%{REQUEST_URI} [L,R=301]

  # 2. Pages of the previous (PHP) website -> their new equivalents
  RewriteRule ^index\.php$ / [L,R=301]
  RewriteRule ^about\.php$ /about [L,R=301]
  RewriteRule ^contact\.php$ /contact [L,R=301]
  RewriteRule ^portfolio\.php$ /portfolio/ [L,R=301]
  RewriteRule ^3d-scanning\.php$ /services/3d-scanning [L,R=301]
  RewriteRule ^3d-printing\.php$ /services/3d-printing [L,R=301]
  RewriteRule ^product-development\.php$ /services/ [L,R=301]

  # 3. Source and tooling files are not part of the public website
  RewriteRule ^(build|data|collateral|\.github|\.git)(/|$) - [F,L]
  RewriteRule ^([^/]+\.md|README\.txt|netlify\.toml|enquiry-config(\.sample)?\.php)$ - [F,L]

  # 4. Clean URLs: /about serves about.html, /services/3d-scanning serves services/3d-scanning.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# Belt and braces for the config file holding the mail password
<Files "enquiry-config.php">
  Require all denied
</Files>
<FilesMatch "\.(md|py|toml|yml|yaml|csv|sample\.php)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # HTML always revalidates; CSS/JS carry ?v=<hash> so they can be cached for a year
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>
